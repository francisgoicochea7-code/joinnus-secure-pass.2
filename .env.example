# =========================================================================
#  JOINNUS SECURE PASS — .env.example
#  Copia este archivo como ".env" y ajusta los valores si lo necesitas:
#      copy .env.example .env      (Windows)
#      cp .env.example .env        (Linux / macOS)
#  El ".env" real esta ignorado por .gitignore: nunca se sube a git.
#  OJO: sin .env (o sin QR_SECRET) docker compose NO arranca.
# =========================================================================

# --- Puertos publicados en tu equipo -------------------------------
# La version 2 usa 8081/3001/5433 para convivir con la version 1.
FRONTEND_PORT=8081
BACKEND_PORT=3001
POSTGRES_PORT=5433

# --- Base de datos (PostgreSQL 16) -----------------------------------
DB_NAME=joinnus_secure_pass
DB_USER=joinnus
DB_PASSWORD=joinnus_pass

# --- Seguridad de los tokens QR -------------------------------------
# Secreto con el que se firman los codigos QR (HMAC-SHA256).
# OBLIGATORIO: minimo 16 caracteres. Genera uno propio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SECRET=

# --- Secreto de las sesiones de usuario -----------------------------
# Firma el token que devuelve /api/usuarios/login (8 horas de vigencia).
# Si lo dejas vacio, el servidor deriva uno a partir de QR_SECRET para que
# el prototipo funcione en local. En produccion define uno propio de al
# menos 32 caracteres: si cambia, todos deben volver a iniciar sesion.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#SESSION_SECRET=

# Vigencia de cada token dinamico, en segundos (15 = rotacion del QR)
QR_TTL_SECONDS=15

# --- Origenes permitidos (CORS) -------------------------------------
# El frontend de esta misma maquina ya esta permitido. Si proyectas la
# demo desde otro equipo de la red, anade su origen separado por comas:
#   CORS_ORIGINS=http://localhost:8081,http://192.168.1.50:8081
# Las redes privadas (192.168.x, 10.x, 172.16-31.x) se admiten solas.
#CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# --- Limites de peticiones (anti fuerza bruta) ----------------------
# Ventana en milisegundos y maximo de peticiones permitidas en esa ventana.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_QR=30
RATE_LIMIT_VALIDAR=60
RATE_LIMIT_ESCRITURA=20
# Intentos de acceso al panel de encargados (/staff/) por ventana
RATE_LIMIT_ENCARGADO=12

# --- Usuario de la sesion de demostracion ---------------------------
# DNI ficticio de "Carlos Perez" (usuario del dashboard)
DEMO_DNI=45678945

# --- Zona horaria ---------------------------------------------------
TZ=America/Lima
