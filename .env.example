# =========================================================================
#  JOINNUS SECURE PASS — .env.example
#  Copia este archivo como ".env" y ajusta los valores si lo necesitas:
#      copy .env.example .env      (Windows)
#      cp .env.example .env        (Linux / macOS)
#  Si no existe ".env", docker-compose.yml usa estos mismos valores por defecto.
# =========================================================================

# --- Puertos publicados en tu equipo -------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=3000
MYSQL_PORT=3307

# --- Base de datos ---------------------------------------------------
DB_NAME=joinnus_secure_pass
DB_USER=joinnus
DB_PASSWORD=joinnus_pass
MYSQL_ROOT_PASSWORD=root_pass_demo

# --- Seguridad de los tokens QR -------------------------------------
# Secreto usado para firmar los codigos QR con HMAC-SHA256.
# En una exposicion puedes dejar el valor por defecto.
QR_SECRET=joinnus-secure-pass-clave-de-demostracion

# Vigencia de cada token dinamico, en segundos (15 = rotacion del QR)
QR_TTL_SECONDS=15

# --- Usuario de la sesion de demostracion ---------------------------
# DNI ficticio de "Carlos Perez" (usuario del dashboard)
DEMO_DNI=45678945

# --- Zona horaria ---------------------------------------------------
TZ=America/Lima
