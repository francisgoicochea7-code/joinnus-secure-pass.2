# =========================================================================
#  JOINNUS SECURE PASS — .env.remota.example
# -------------------------------------------------------------------------
#  Datos del PostgreSQL REMOTO que usará la API desplegada en Vercel.
#
#  1) Copia este fichero a  .env.remota  (no se sube al repositorio)
#  2) Rellena con los valores de tu proveedor (Aiven, Neon, Supabase…)
#  3) npm run db:remoto          -> crea tablas y datos de la demo
#     npm run db:remoto -- --reset   -> empieza de cero
#
#  En Vercel hay que declarar LAS MISMAS variables en
#  Settings -> Environment Variables (DB_SSL, QR_SECRET y TZ incluidos).
# =========================================================================

DB_HOST=tu-base.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=********
DB_NAME=joinnus_secure_pass

# Los PostgreSQL remotos (Aiven, Neon, Supabase…) exigen TLS.
# En Docker se deja vacío.
DB_SSL=true

# Aiven firma con su propia autoridad: pega aquí el certificado (o la ruta de
# un fichero .pem) que da la consola en Service settings -> CA Cert.
# Con Neon o Supabase no hace falta (certificado de una CA pública).
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Alternativa a la CA: cifra la conexión sin verificar el certificado.
DB_SSL_INSECURE=true

# Firma de los tokens QR: la misma que uses en Vercel.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SECRET=
TZ=America/Lima
