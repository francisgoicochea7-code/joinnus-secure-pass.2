# =========================================================================
#  JOINNUS SECURE PASS — .env.micro.example
#  Copia este archivo como ".env.micro" y cambia TODOS los valores.
#
#      copy .env.micro.example .env.micro      (Windows)
#      cp .env.micro.example .env.micro        (Linux / macOS)
#
#  Genera secretos fuertes con:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
#  El archivo ".env.micro" está ignorado por git: nunca se sube.
# =========================================================================

# --- Puertos publicados en tu equipo (no chocan con la versión 1) -----
MICRO_HTTP_PORT=8082
MICRO_HTTPS_PORT=8444
MICRO_POSTGRES_PORT=5434

# --- PostgreSQL: administrador y tres usuarios ------------------------
POSTGRES_ADMIN_PASSWORD=cambia_esto_admin
AUTH_DB_PASSWORD=cambia_esto_auth
TICKETS_DB_PASSWORD=cambia_esto_tickets
QR_DB_PASSWORD=cambia_esto_qr

# --- Seguridad entre microservicios ----------------------------------
# Token compartido para los endpoints /internal/v1/*. Mínimo 16 caracteres.
INTERNAL_TOKEN=cambia_esto_token_interno_de_32_caracteres

# --- Firma de los tokens QR ------------------------------------------
# OBLIGATORIO: mínimo 16 caracteres. No se publica en el repositorio.
QR_SECRET=cambia_esto_secreto_qr_de_32_caracteres

# Vigencia de cada token dinámico, en segundos.
QR_TTL_SECONDS=15

# --- Sesión de demostración ------------------------------------------
DEMO_DNI=45678945

# --- Zona horaria ----------------------------------------------------
TZ=America/Lima
