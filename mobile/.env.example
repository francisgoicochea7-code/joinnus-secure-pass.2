# Opcional: fuerza la URL de la API en la app.
# Si no se define, en Expo Go se usa http://<IP-del-Metro>:8091/api
# y en una build de produccion se usa Render.
#
# Render:
# EXPO_PUBLIC_API_URL=https://joinnus-secure-pass2.onrender.com/api
#
# Local con el proxy incluido:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8091/api
