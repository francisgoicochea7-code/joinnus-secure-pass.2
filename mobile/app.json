{
  "expo": {
    "name": "Joinnus Encargados",
    "slug": "joinnus-secure-pass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/pass-512.png",
    "scheme": "joinnussecurepass",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joinnus.securepass"
    },
    "android": {
      "package": "com.joinnus.securepass",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/pass-512.png",
        "backgroundColor": "#08090d"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permite a Joinnus Encargados escanear los QR de las entradas.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08090d",
          "image": "./assets/pass-512.png",
          "imageWidth": 180
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3f8f7dbf-c10a-4e45-ac41-39aa5d2b2dd7"
      }
    }
  }
}
